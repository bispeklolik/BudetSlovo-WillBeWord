{
  "name": "slovo",
  "version": "0.3.0",
  "private": true,
  "description": "Слово — локальный редактор расшифровок аудио (психолог/клиент)",
  "author": "Matvey Bogatyrev <bispeklolik@gmail.com>",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icon": "node scripts/make-icon.mjs",
    "dev:web": "vite --config vite.config.web.ts",
